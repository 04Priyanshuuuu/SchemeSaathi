generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  name         String?
  email        String   @unique
  password     String?
  googleId      String?  @unique
  profileImage String?
  isVerified   Boolean  @default(false)
  role         Role     @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}